# Copy to .env (gitignored) and fill in WORKSPACE_DIR. Everything else has a
# working default or is optional. For optional in-container developer tooling
# (Claude Code / Codex / Notion MCP / SSH + gh), see
# docker-compose.override.example.yml.

# === Project settings ===
PROJECT_NAME=hol-pcfg
WORKSPACE_DIR=<your-workspace-dir>

# === Docker settings ===
CONTAINER_NAME=holpcfg
IMAGE_NAME=holpcfg
SHM_SIZE=128gb
HOST_UID=1000
HOST_GID=1000

# === Git settings ===
GIT_AUTHOR_NAME=<your-git-name>
GIT_AUTHOR_EMAIL=<your-git-email>
GIT_SAFE_DIRECTORY=/workspace/hol-pcfg

# === API keys / tokens ===
# Optional: only needed when a config sets wandb.enabled: true.
WANDB_API_KEY=<your-wandb-api-key>
# Optional: used by the SemInfo paraphrase preprocessing.
OPENAI_API_KEY=<your-openai-api-key>
